{
  "manifest_version": 2,
  "name": "TorBox Magnet",
  "version": "1.0.0",
  "description": "Send magnet links directly to your TorBox account.",
  "browser_specific_settings": {
    "gecko": {
      "id": "torbox-magnet@dev",
      "strict_min_version": "91.0"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "downloads",
    "https://*.torbox.app/"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    },
    "default_title": "TorBox Magnet",
    "default_popup": "src/popup.html",
    "browser_style": false
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  }
}
